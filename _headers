# v18 perf: 强制 HTML 不被任何层 cache, 确保用户总拿最新版本
# CF Pages 边缘 cache 默认 7 天, 必须显式覆盖
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
# v25.51: 公开 manage API (GET) 用函数返回的 Cache-Control: public, max-age=60 缓存
# 必须放在 / 规则之前, 否则被 / 的 no-cache 覆盖
/api/*
  Cache-Control: public, max-age=60
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
/admin
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
/admin.html
  Cache-Control: no-cache, no-store, must-revalidate
